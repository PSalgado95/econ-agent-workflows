      "persona_created": false,
      "required_destinations": [
        "software-equivalence",
        "transformation-and-sample",
        "reproducibility"
      ],
      "allocation": "Software equivalence owns comparison design, independent paths, tolerances, object-before-numeric parity, and discrepancy classification. Transformation and sample joins when construction or realised-sample parity is material. Reproducibility joins when rerun, input-version, build, or environment parity is material."
    },
    "hybrid-implementation": {
      "persona_created": false,
      "required_destinations": [
        "code-quality",
        "estimation-practice",
        "transformation-and-sample",
        "reproducibility",
        "output-consistency"
      ],
      "allocation": "Code quality owns transparency, interface defaults, parameter plumbing, tests, and hidden machinery. Estimation practice owns estimator and numerical validity. Transformation and sample, reproducibility, and output consistency join when the custom path can change their objects."
    }
  },
