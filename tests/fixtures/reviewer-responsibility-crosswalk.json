    },
    {
      "obligation_id": "HYBRID-002",
      "source_agents": [
        "econ-hybrid-implementation-reviewer.toml"
      ],
      "obligation": "Audit custom interfaces, hidden defaults, parameter plumbing, manifests, and non-standard execution machinery according to the analytical surface they can alter.",
      "destinations": [
        "persona:code-quality:Required checks",
        "persona:estimation-practice:Required checks",
        "persona:reproducibility:Required checks",
        "persona:output-consistency:Required checks"
      ]
    },
    {
      "obligation_id": "INFERENCE-001",
      "source_agents": [
        "econ-inference-reviewer.toml"
      ],
      "obligation": "Check whether uncertainty matches the design, estimator, dependence structure, and claim.",
      "destinations": [
        "persona:inference:Remit",
        "persona:inference:Required checks"
      ]
    },
    {
      "obligation_id": "INFERENCE-002",
      "source_agents": [
        "econ-inference-reviewer.toml"
      ],
      "obligation": "Check standard-error or test type, cluster level, cluster counts, and assignment-level alignment.",
      "destinations": [
        "persona:inference:Required checks"
      ]
    },
    {
      "obligation_id": "INFERENCE-003",
      "source_agents": [
        "econ-inference-reviewer.toml"
      ],
      "obligation": "Check small or uneven clusters, multiway or nested clustering, and serial, spatial, or network dependence.",
      "destinations": [
        "persona:inference:Required checks"
      ]
    },
    {
      "obligation_id": "INFERENCE-004",
      "source_agents": [
        "econ-inference-reviewer.toml"
      ],
      "obligation": "Check wild or other bootstrap, randomisation, and HAC remedies when relevant.",
      "destinations": [
        "persona:inference:Required checks"
      ]
    },
    {
      "obligation_id": "INFERENCE-005",
      "source_agents": [
        "econ-inference-reviewer.toml"
      ],
      "obligation": "Check weak-IV, RD bias-corrected, RCT design-based, and dynamic-band inference when relevant.",
      "destinations": [
        "persona:inference:Required checks"
      ]
    },
