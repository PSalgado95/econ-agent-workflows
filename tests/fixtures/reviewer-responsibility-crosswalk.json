        "persona:claim-discipline:Required checks"
      ]
    },
    {
      "obligation_id": "CLAIM-002",
      "source_agents": [
        "econ-claim-discipline-reviewer.toml"
      ],
      "obligation": "Police interpretation boundaries, benchmark language, and note overreach.",
      "destinations": [
        "persona:claim-discipline:Required checks"
      ]
    },
    {
      "obligation_id": "CODE-001",
      "source_agents": [
        "econ-code-quality-reviewer.toml"
      ],
      "obligation": "Check whether research code can be read, checked, rerun, safely modified, and handed to another researcher without hiding the research object.",
      "destinations": [
        "persona:code-quality:Remit",
        "research-code-quality:Always-on floor"
      ]
    },
    {
      "obligation_id": "CODE-002",
      "source_agents": [
        "econ-code-quality-reviewer.toml"
      ],
      "obligation": "Flag code defects only when they affect readability, rerun, modification, reviewability, or research trust.",
      "destinations": [
        "persona:code-quality:Remit",
        "persona:code-quality:Prohibited overreach",
        "research-code-quality:Purpose"
      ]
    },
    {
      "obligation_id": "CODE-003",
      "source_agents": [
        "econ-code-quality-reviewer.toml"
      ],
      "obligation": "Suppress pure style nits and language preferences.",
      "destinations": [
        "persona:code-quality:Prohibited overreach"
      ]
    },
    {
      "obligation_id": "CODE-004",
      "source_agents": [
        "econ-code-quality-reviewer.toml"
      ],
      "obligation": "Do not decide whether a sample rule, estimator, inference choice, or substantive claim is correct.",
      "destinations": [
        "persona:code-quality:Prohibited overreach",
        "research-code-quality:Hidden machinery"
      ]
    },
    {
      "obligation_id": "CODE-005",
      "source_agents": [
        "econ-code-quality-reviewer.toml"
      ],
      "obligation": "Check for hidden transformations, missing invariant checks, buried debug or test fragments, notebook-only durable logic, and unclear entrypoints.",
      "destinations": [
        "persona:code-quality:Required checks",
        "research-code-quality:Always-on floor",
        "research-code-quality:Hidden machinery"
      ]
    },
    {
      "obligation_id": "CODE-006",
      "source_agents": [
        "econ-code-quality-reviewer.toml"
      ],
      "obligation": "Give performance advice only when performance is explicitly in scope or supported by bottleneck evidence.",
      "destinations": [
        "persona:code-quality:Required checks",
        "research-code-quality:Performance"
      ]
    },
    {
      "obligation_id": "CODE-007",
      "source_agents": [
        "econ-code-quality-reviewer.toml"
      ],
      "obligation": "Use the supplied research-code-quality guardrail when provided.",
      "destinations": [
        "subagent-template:method-guardrails",
        "persona:code-quality:Required checks",
        "research-code-quality:Purpose"
      ]
    },
    {
      "obligation_id": "CROSSLANG-001",
      "source_agents": [
        "econ-cross-language-validation-reviewer.toml"
      ],
      "obligation": "Audit whether a requested or existing cross-language comparison is scoped correctly and independent enough to test object parity before numeric parity.",
      "destinations": [
        "persona:software-equivalence:Remit",
        "persona:software-equivalence:Required checks",
        "persona-catalog:Cross-language fold"
      ]
    },
    {
      "obligation_id": "CROSSLANG-002",
      "source_agents": [
        "econ-cross-language-validation-reviewer.toml"
      ],
      "obligation": "Select cross-language review only for an explicit request, a validation manifest or comparison target, or an explicit equivalence claim.",
      "destinations": [
        "persona-catalog:Conditional triggers",
        "persona-catalog:Cross-language fold"
      ]
    },
    {
      "obligation_id": "CROSSLANG-003",
      "source_agents": [
        "econ-cross-language-validation-reviewer.toml"
      ],
      "obligation": "When validation has not run, report the missing target, language paths, input version, parity checks, tolerance rules, and discrepancy categories as diagnostic gaps without creating scripts.",
      "destinations": [
        "persona:software-equivalence:Evidence expectations",
        "persona:software-equivalence:Prohibited overreach"
      ]
    },
    {
      "obligation_id": "CROSSLANG-004",
      "source_agents": [
        "econ-cross-language-validation-reviewer.toml"
      ],
      "obligation": "Audit validation-manifest completeness, independent code paths, and input version.",
      "destinations": [
        "persona:software-equivalence:Required checks",
        "persona:reproducibility:Required checks"
      ]
    },
    {
      "obligation_id": "CROSSLANG-005",
      "source_agents": [
        "econ-cross-language-validation-reviewer.toml"
      ],
      "obligation": "Audit parity of sample, variables, weights, fixed effects, clusters, and missingness before numerical comparison.",
      "destinations": [
        "persona:software-equivalence:Required checks",
        "persona:transformation-and-sample:Required checks"
      ]
    },
    {
      "obligation_id": "CROSSLANG-006",
      "source_agents": [
        "econ-cross-language-validation-reviewer.toml"
      ],
      "obligation": "Audit coefficient and standard-error comparisons, degrees-of-freedom conventions, and discrepancy explanations.",
      "destinations": [
        "persona:software-equivalence:Required checks"
      ]
    },
    {
      "obligation_id": "CROSSLANG-007",
      "source_agents": [
        "econ-cross-language-validation-reviewer.toml"
      ],
      "obligation": "Do not silently broaden ordinary empirical review into cross-language validation.",
      "destinations": [
        "persona:software-equivalence:Prohibited overreach",
        "persona-catalog:Cross-language fold"
      ]
    },
    {
      "obligation_id": "DESIGN-001",
      "source_agents": [
        "econ-design-reviewer.toml"
      ],
      "obligation": "Check whether the estimand-to-design mapping remains coherent.",
      "destinations": [
        "persona:design:Remit",
        "persona:design:Required checks"
      ]
    },
    {
      "obligation_id": "DESIGN-002",
      "source_agents": [
        "econ-design-reviewer.toml"
      ],
      "obligation": "Apply only the method guardrails relevant to the visible design.",
      "destinations": [
        "subagent-template:method-guardrails",
        "persona:design:Prohibited overreach"
      ]
    },
    {
      "obligation_id": "DESIGN-003",
      "source_agents": [
        "econ-design-reviewer.toml"
      ],
      "obligation": "For DiD and event studies, check treatment timing, comparison group, support, anticipation, and heterogeneous-effect risks.",
      "destinations": [
        "persona:design:Required checks"
      ]
    },
    {
      "obligation_id": "DESIGN-004",
      "source_agents": [
        "econ-design-reviewer.toml"
      ],
      "obligation": "For IV, check first stage, reduced form, exclusion, monotonicity or complier interpretation, and weak-instrument diagnostic evidence.",
      "destinations": [
        "persona:design:Required checks",
        "persona:inference:Required checks"
      ]
    },
    {
      "obligation_id": "DESIGN-005",
      "source_agents": [
        "econ-design-reviewer.toml"
      ],
      "obligation": "For RD, check running variable, cutoff, bandwidth, manipulation, balance, and fuzzy or local-randomisation details.",
      "destinations": [
        "persona:design:Required checks",
        "persona:inference:Required checks"
      ]
    },
    {
      "obligation_id": "DESIGN-006",
      "source_agents": [
        "econ-design-reviewer.toml"
      ],
      "obligation": "For RCTs, check randomisation unit, compliance, attrition, interference, and design-consistent inference evidence.",
      "destinations": [
        "persona:design:Required checks",
        "persona:inference:Required checks"
      ]
    },
    {
      "obligation_id": "DESIGN-007",
      "source_agents": [
        "econ-design-reviewer.toml"
      ],
      "obligation": "For synthetic control and selection-on-observables, check donor, overlap, balance, and weight evidence.",
      "destinations": [
        "persona:design:Required checks"
      ]
    },
    {
      "obligation_id": "DYNAMICS-001",
      "source_agents": [
        "econ-dynamics-reviewer.toml"
      ],
      "obligation": "Check that timing, horizon, lag, cumulative or level, reference-period, and confidence-band conventions match the interpreted object.",
      "destinations": [
        "persona:dynamics:Remit",
        "persona:dynamics:Required checks"
      ]
    },
    {
      "obligation_id": "DYNAMICS-002",
      "source_agents": [
        "econ-dynamics-reviewer.toml"
      ],
      "obligation": "Prioritize horizon-specific N, support, and cluster counts.",
      "destinations": [
        "persona:dynamics:Required checks"
      ]
    },
    {
      "obligation_id": "DYNAMICS-003",
      "source_agents": [
        "econ-dynamics-reviewer.toml"
      ],
      "obligation": "Check event-time omitted periods, binned leads and lags, shock timing, and lag-control conventions.",
      "destinations": [
        "persona:dynamics:Required checks"
      ]
    },
    {
      "obligation_id": "DYNAMICS-004",
      "source_agents": [
        "econ-dynamics-reviewer.toml"
      ],
      "obligation": "Distinguish level, change, cumulative, annualised, and other dynamic response objects.",
      "destinations": [
        "persona:dynamics:Required checks"
      ]
    },
    {
      "obligation_id": "ESTIMATION-001",
      "source_agents": [
        "econ-estimation-practice-reviewer.toml"
      ],
      "obligation": "Check that the code path implements the claimed estimator, fixed effects, weights, controls, omitted categories, and model metadata.",
      "destinations": [
        "persona:estimation-practice:Remit",
        "persona:estimation-practice:Required checks"
      ]
    },
    {
      "obligation_id": "ESTIMATION-002",
      "source_agents": [
        "econ-estimation-practice-reviewer.toml"
      ],
      "obligation": "Do not duplicate inference review; only flag missing inference metadata in the model ledger at this lens.",
      "destinations": [
        "persona:estimation-practice:Prohibited overreach"
      ]
    },
    {
      "obligation_id": "ESTIMATION-003",
      "source_agents": [
        "econ-estimation-practice-reviewer.toml"
      ],
      "obligation": "Route clustering, weak-instrument inference, finite-sample corrections, randomisation inference, horizon bands, and multiplicity to inference.",
      "destinations": [
        "persona:estimation-practice:Prohibited overreach",
        "persona:inference:Required checks"
      ]
    },
    {
      "obligation_id": "HYBRID-001",
      "source_agents": [
        "econ-hybrid-implementation-reviewer.toml"
      ],
      "obligation": "Check whether non-standard software machinery can change the empirical object even when economist-facing artifacts look plausible.",
      "destinations": [
        "persona:code-quality:Required checks",
        "persona:estimation-practice:Required checks",
        "persona:transformation-and-sample:Required checks",
        "persona:reproducibility:Required checks",
        "persona:output-consistency:Required checks",
        "persona-catalog:Hybrid/custom implementation fold"
