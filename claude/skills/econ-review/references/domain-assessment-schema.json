{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://econ-agent-workflows.local/schemas/econ-domain-assessment-v1.json",
  "title": "econ-domain-assessment/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "assessment_type",
    "subject",
    "status",
    "producer",
    "evidence_reviewed",
    "observations",
    "limitations",
    "coverage_note"
  ],
  "properties": {
    "schema_version": {
      "const": "econ-domain-assessment/v1"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "assessment_type": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "version"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "skill",
            "generic-agent",
            "human",
            "imported-tool"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "evidence_reviewed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^E[1-9][0-9]*$"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "topic",
          "summary",
          "importance",
          "evidence_refs",
          "limitations"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^O[1-9][0-9]*$"
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "type": "string",
            "enum": [
              "blocking",
              "material",
              "advisory",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^E[1-9][0-9]*$"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage_note": {
      "type": "string",
      "minLength": 1
    }
  }
}
